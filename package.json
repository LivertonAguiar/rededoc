{
  "name": "rededoc",
  "version": "1.0.0",
  "description": "RedeDoc — Sistema de Documentação e Gerenciamento de Infraestrutura de Redes",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "node server/dist/index.js",
    "seed": "npm run seed --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0"
  }
}
