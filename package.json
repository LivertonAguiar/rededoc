{
  "name": "itfy",
  "version": "1.0.3",
  "description": "ITFY — Sistema de Documentação e Gerenciamento de Infraestrutura de Redes e TI",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:all": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "start": "node server/dist/index.js",
    "seed": "npm run seed --workspace=server",
    "import:articles": "npm run import:articles --workspace=server",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "archiver": "^8.0.0"
  }
}
