# Configurações do Servidor ITFY (Self-Hosted - Proxmox / VPS)
PORT=3001
NODE_ENV=production

# Diretórios de Armazenamento Persistente no Container
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# Segurança e Criptografia (Cofre de Senhas AES-256-GCM e Sessão JWT)
# IMPORTANTE: Gere chaves fortes e exclusivas para a sua instância
VAULT_SECRET_KEY=chave-mestre-secreta-para-o-cofre-de-senhas-256bits-producao
JWT_SECRET=seu-jwt-secret-seguro-para-autenticacao-producao

