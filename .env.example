# Configurações do Servidor RedeDoc
PORT=3001
NODE_ENV=development

# Diretórios de Armazenamento
DATA_DIR=./data
UPLOAD_DIR=./uploads

# Segurança e Criptografia (Cofre de Senhas AES-256-GCM e Sessão JWT)
# Defina chaves fortes e únicas para ambientes de produção
VAULT_SECRET_KEY=sua-chave-mestre-secreta-para-o-cofre-de-senhas-256bits
JWT_SECRET=seu-jwt-secret-seguro-para-autenticacao

