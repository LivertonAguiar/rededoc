# Configurações do Servidor ITFY (Produção Self-Hosted - Proxmox / VPS)
PORT=3001
NODE_ENV=production

# Diretórios de Armazenamento Persistente
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# Segurança e Criptografia (OBRIGATÓRIO EM PRODUÇÃO)
# O servidor falhará na inicialização se estas duas variáveis não forem fornecidas.
# Gere valores randômicos e fortes (mínimo 32 caracteres) para cada implantação.
VAULT_SECRET_KEY=sua-chave-mestre-secreta-para-o-cofre-de-senhas-256bits-vps
JWT_SECRET=seu-jwt-secret-seguro-para-autenticacao-de-sessoes-vps

